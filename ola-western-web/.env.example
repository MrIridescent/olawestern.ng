# ── Data backend ─────────────────────────────────────────────────
# With no Supabase credentials set, the campaign runs its own persistent
# JSON data store at ./data/db.json (leads, Truth Room ledger, newsroom,
# track record — all written through /admin). Set these to move to Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Reads use the anon key, so RLS keeps unpublished rows off the public pages.
# Writes (the CMS and the /join form) use SUPABASE_SERVICE_ROLE_KEY — the tables
# are write-protected for the anon key by design. Without it, /admin writes fail
# once Supabase is configured; leave all three blank to run on ./data/db.json.
# Never put the service-role key in a NEXT_PUBLIC_* variable.
# Override the data-store location (e.g. a mounted volume on the server):
# DATA_DIR=/data/ola-western

# ── Campaign CMS (/admin) ────────────────────────────────────────
# REQUIRED in production. Without ADMIN_PASSWORD the build uses the clearly
# warned local-dev password. ADMIN_SECRET signs the session cookie — set a
# long random string so sessions stay valid even if the password rotates.
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_SECRET=change-me-to-a-long-random-string

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── AI Campaign War Room ─────────────────────────────────────────
WAR_ROOM_WEBHOOK_URL=https://warroom.i2sltd.tech/api/v1/leads
# Shared secret used by the War Room -> Truth Room sync webhook
WAR_ROOM_SECRET_KEY=change-me-to-a-long-random-string

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.olawestern.ng
NEXT_PUBLIC_WHATSAPP_NUMBER=2349041258180
