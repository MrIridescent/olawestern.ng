# ── Data backend ─────────────────────────────────────────────────
# With no Supabase credentials set, the campaign runs its own persistent
# JSON data store at ./data/db.json (leads, Truth Room ledger, newsroom,
# track record — all written through /admin). Set these to move to Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Reads use the anon key, so RLS keeps unpublished rows off the public pages.
# Writes (the CMS and the /join form) use SUPABASE_SERVICE_ROLE_KEY — the tables
# are write-protected for the anon key by design. Without it, /admin writes fail
# once Supabase is configured; leave all three blank to run on ./data/db.json.
# Never put the service-role key in a NEXT_PUBLIC_* variable.
# Override the data-store location (e.g. a mounted volume on the server):
# DATA_DIR=/data/ola-western

# ── Campaign CMS (/admin) ────────────────────────────────────────
# REQUIRED in production. Without ADMIN_PASSWORD the build uses the clearly
# warned local-dev password. ADMIN_SECRET signs the session cookie — set a
# long random string so sessions stay valid even if the password rotates.
# Never reuse the values below. Generate fresh ones:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SECRET=change-me-to-a-long-random-string

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── AI Campaign War Room ─────────────────────────────────────────
WAR_ROOM_WEBHOOK_URL=https://warroom.olawestern.ng/api/v1/leads
# Shared secret used by the War Room -> Truth Room sync webhook
WAR_ROOM_SECRET_KEY=change-me

# ── Truth Desk (live AI fact-check chat) ─────────────────────────
# At least one provider key is required for the conversational desk on
# /truth-room. With no key the endpoint returns an honest 503 and the UI
# shows setup instructions — it never substitutes a canned answer.
# auto tries OpenAI first, then Gemini, when both keys exist.
# Up to three keys per provider. The desk rotates on a rejected key, a
# 429/503 rate limit, a timeout or a provider error, and starts the next
# question on the next key so quota is shared rather than burned in order.
# A single variable may also hold a comma-separated list.
TRUTH_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GOOGLE_AI_API_KEY/_2/_3 are accepted aliases for the Gemini slots above.
GEMINI_MODEL=gemini-3.5-flash
# Optional: route through an OpenAI-compatible gateway or a Gemini proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Email notifications (Resend) ─────────────────────────────────
# Optional. Form leads are always saved to the store first; email is only a
# notification. Verify olawestern.ng in Resend before using this exact sender.
RESEND_API_KEY=
EMAIL_FROM="Ola Western Campaign <mail@ekaro.olawestern.ng>"
EMAIL_TO="ekabo@olawestern.ng"

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.olawestern.ng
NEXT_PUBLIC_WHATSAPP_NUMBER=2348034005708
